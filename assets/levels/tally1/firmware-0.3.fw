firmware "Tally-1 firmware 0.3" for tally1

cell tally at M2        ; count

entry start {
    a = 0
    tally = a           ; the display shows 0
}

block count {
    wait
    a = tally + 1
    if a < 10 goto show
    a = 0               ; after 9 comes 0
}

block show {
    tally = a
    bug "jump-start" {
        fixed {
            goto count  ; wait for the next press
        }
        buggy {
            goto start  ; wait for the next press
        }
    }
}

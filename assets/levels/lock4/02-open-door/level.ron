(
    id: "lock4-02",
    title: "Open door",
    device: Lock4,
    chip: Calco((revision: C, date_code: 7630)),
    unit: "00561",
    remarks: ["new-code", "first-thinking"],
    rom: (kind: Eprom, blank_available: true),
    tests: [
        (keys: "C *42#", display: "0042 SHUT"),
        (keys: "C *42# C 42#", display: "0042 SHUT"),
        (keys: "C #*42# C 42#", display: "0042 OPEN"),
    ],
    reward: 20,
    firmware: Some((source: "lock4/firmware.fw", switches: ["open-change"])),
)

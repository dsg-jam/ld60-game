firmware "Tally-1 firmware 0.1" for tally1

cell tally at M2        ; count

entry start {
    bug "start-five" {
        fixed {
            a = 0       ; put 0 in A
        }
        buggy {
            a = 5       ; put 5 in A
        }
    }
    tally = a           ; show it
}

block count {
    wait                ; wait for a key press
    a = tally + 1       ; one more
    if a < 10 goto show
    a = 0               ; after 9 comes 0
}

block show {
    tally = a
    goto count
}

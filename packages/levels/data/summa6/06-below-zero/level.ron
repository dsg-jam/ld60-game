(
    id: "summa6-06",
    title: "Below zero",
    device: Summa6,
    chip: Calco((revision: B, date_code: 7630)),
    serial: "6A-04890",
    remarks: [
        "The minus mark lights up when every stroke is tested.",
        "Customer wants to see when there is less than nothing.",
    ],
    rom: (kind: Eprom, blank_available: true),
    customer: (
        name: "Yimbo, student",
        complaint: "12 minus 34 is 999978? My money pouch says otherwise. Where is the minus mark?",
    ),
    tests: [
        (keys: "12-34=", display: "-000022"),
        (keys: "34-12=", display: "000022"),
        (keys: "12-34=5", display: "000005"),
        (keys: "12-34=C", display: "000000"),
        (keys: "5-10+3=", display: "-000002"),
    ],
    reward: 30,
    firmware: Some((source: "summa6/firmware.fw", switches: ["negative"])),
)

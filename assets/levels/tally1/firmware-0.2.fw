firmware "Tally-1 firmware 0.2" for tally1

cell tally at M2        ; count

entry start {
    a = 0
    tally = a
}

block count {
    wait                ; wait for a key press
    a = tally + 1       ; A = the digit, plus one
    bug "double-count" {
        buggy {
            a += 1      ; and one more
        }
    }
    if a < 10 goto show
    a = 0               ; after 9 comes 0
}

block show {
    tally = a           ; show it
    goto count          ; back up to count
}

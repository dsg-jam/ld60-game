rent-footer = LANDLORD VRESK
rent-title = RENT
rent-paid = The big ringed one went down, so I took my ${ $amount } from your money box. When it goes down again, I take ${ $next }.
rent-short = The big ringed one went down. You owe me ${ $amount }, but your money box holds only ${ $till }. I lock the door now. Take your human boxes and go.
rent-offer = I am tired of this cold rain. I want to go live by the warm sea. Pay ${ $price } and the building is yours. I left the paper with the scrap trader.
rent-owned = I live by the warm sea now. The building is yours, so I take nothing. The sun here is very nice.
rent-signed = - Vresk, who owns this building
# A sticky note in three lines: a heading, the amount in big writing, and
# when it is due.
reminder =
    Rent
    ${ $amount }
    when the ringed one sets
reminder-owned = No more rent!

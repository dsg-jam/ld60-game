(
    id: "tally2-01",
    title: "Clear key",
    device: Tally2,
    chip: Calco((revision: A, date_code: 7541)),
    serial: "2A-00107",
    remarks: [
        "The C key switch tests fine.",
        "Early unit. Factory firmware 0.9.",
    ],
    rom: (kind: Eprom, blank_available: true),
    customer: (
        name: "Doorman",
        complaint: "I press C before we open, but it keeps counting from last night.",
    ),
    tests: [
        (keys: "", display: "00"),
        (keys: "+", display: "01"),
        (keys: "+++", display: "03"),
        (keys: "+++C", display: "00"),
        (keys: "+++C++", display: "02"),
        (keys: "++++++++++", display: "10"),
    ],
    reward: 3,
    firmware: Some((source: "tally2/firmware-0.9.fw", switches: ["clear-code"])),
)
